# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/school_assessment?schema=public"

# JWT signing secret: a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="1h"

# Demo account passwords used by `npm run db:seed` (at least 12 characters each).
SEED_ADMIN_PASSWORD=""
SEED_OPERATOR_PASSWORD=""
SEED_TEACHER_PASSWORD=""
SEED_STUDENT_PASSWORD=""

# Optional: e2e test database (defaults to DATABASE_URL + "_test")
# TEST_DATABASE_URL=""
